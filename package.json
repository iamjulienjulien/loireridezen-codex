{
    "name": "loireridezen-codex",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "env:switch": "node scripts/switch-env.mjs",
        "env:development": "pnpm env:switch development",
        "env:production": "pnpm env:switch production",
        "features": "node scripts/feature-flags-cli.mjs",
        "features:list": "node scripts/feature-flags-cli.mjs --list",
        "test": "vitest run",
        "api:lint": "redocly lint codex@v1",
        "api:test:contract": "vitest run src/api/contract scripts/api-contract-diff.test.mjs",
        "api:contract:diff": "node scripts/api-contract-diff.mjs",
        "api:contract:update-snapshots": "vitest run src/api/contract/public-shapes.test.ts -u",
        "api:data:check": "vitest run src/data-quality --disableConsoleIntercept",
        "api:docs:check": "node --check docs/api/examples/quickstart.js && tsc --noEmit && vitest run src/api/documentation",
        "api:test:local": "cd bruno/codex-public-api && bru run --env local --sandbox=safe --bail",
        "api:test:production": "cd bruno/codex-public-api && bru run --env production --sandbox=safe --bail --tags=production-safe",
        "api:test:smoke": "cd bruno/codex-public-api && bru run --env production --sandbox=safe --bail --tags=smoke",
        "sdk:generate": "pnpm --filter @loireridezen/codex-sdk generate",
        "sdk:check": "pnpm --filter @loireridezen/codex-sdk check",
        "sdk:build": "pnpm --filter @loireridezen/codex-sdk build",
        "sdk:test": "pnpm --filter @loireridezen/codex-sdk test",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@next/third-parties": "16.2.10",
        "@plausible-analytics/tracker": "^0.4.5",
        "@radix-ui/react-dialog": "^1.1.23",
        "@vercel/analytics": "^2.0.1",
        "@vercel/og": "^0.11.1",
        "lucide-react": "^1.26.0",
        "maplibre-gl": "^6.0.0",
        "mdast-util-directive": "^3.1.0",
        "next": "16.2.10",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-markdown": "^10.1.0",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.3.1",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@redocly/cli": "^2.40.0",
        "@tailwindcss/postcss": "^4",
        "@types/mdast": "^4.0.4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@usebruno/cli": "3.5.2",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "prettier": "^3.9.4",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
}
